{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "HealthLogger/HealthLogger.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": false
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "HealthLogger/HealthLogger.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
